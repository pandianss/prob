{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "probanker/misconception",
  "title": "Misconception",
  "description": "BLUEPRINT.md 2.2. Model-proposed, promoted or demoted by response data (3.7).",
  "type": "object",
  "required": [
    "id",
    "statement",
    "concept",
    "remediation_strategy",
    "status",
    "ladder"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "<CERT>.<SUBJECT>.<TOPIC>.<SLUG>",
      "pattern": "^[A-Z]{3,6}\\.[A-Z]{2,6}\\.[A-Z0-9-]{2,20}\\.[A-Z0-9-]{3,40}$"
    },
    "statement": {
      "type": "string",
      "minLength": 25
    },
    "concept": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,60}$"
    },
    "signature": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remediation_strategy": {
      "enum": [
        "contrast-cases",
        "clause-anchor",
        "boundary-probe",
        "quantity-intuition"
      ],
      "description": "2.4 - each maps to one rendering component."
    },
    "canned_hint_l1": {
      "type": "string",
      "minLength": 10,
      "description": "Authored, not generated - this is what makes offline tutoring work on every device (8)."
    },
    "canned_hint_l2": {
      "type": "string",
      "minLength": 10
    },
    "worked_example_ref": {
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed",
        "validated",
        "demoted"
      ],
      "description": "3.7 mechanism 5: proposed until response data confirms learners hold it."
    },
    "prevalence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1,
      "description": "null until measured. Never a guess."
    },
    "n_observations": {
      "type": "integer",
      "minimum": 0
    },
    "ladder": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 10
      },
      "description": "Authored Socratic rungs in order: PROBE, NARROW, HINT_L1, HINT_L2 (BLUEPRINT 2.3). No model runs in a learner session."
    }
  }
}
