        "misconception": "ABFM.B.LEV.RATIO-INVERTED"
      }
    ],
    "resolution": "EBT is 1,20,000 less 40,000 = 80,000. Combined leverage is contribution over EBT = 3,00,000 / 80,000 = 3.75 - the same as DOL of 2.5 times DFL of 1.5.",
    "grounding_regime": "doctrinal",
    "grounding": [
      {
        "kind": "definition",
        "source": "Degree of combined leverage",
        "locator": "DCL = DOL x DFL = Contribution / EBT"
      }
    ],
    "derived_from": [
      {
        "work": "macmillan/CAIIB-ABFM",
        "edition": "2023",
        "unit": 8,
        "section": "8.6"
      }
    ],
    "verification": {
      "entailed_span": "DTL = DFL × DOL",
      "second_model_agrees": true,
      "arithmetic": {
        "expression": "contribution / (ebit - interest)",
        "expected": 3.75,
        "tolerance": 0.005
      },
      "verifier": {
        "model": "gemini/antigravity",
        "packet": "v20260923-092220",
