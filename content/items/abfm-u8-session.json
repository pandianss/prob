  {
    "item_id": "itm_abfm_u8_s04_bep",
    "syllabus_node": "ABFM.B.8.5",
    "concept": "contribution-and-cost-behaviour",
    "prereqs": [
      "ratio-arithmetic"
    ],
    "bloom": "apply",
    "tier": "caiib",
    "stem": "A product sells at Rs. 50 with a variable cost of Rs. 32 a unit. Fixed cost is Rs. 90,000, and 8,000 units are currently sold. How many units must be sold to break even?",
    "given": [
      {
        "label": "Price",
        "value": 50,
        "unit": "INR"
      },
      {
        "label": "Variable cost",
        "value": 32,
        "unit": "INR"
      },
      {
        "label": "Fixed cost",
        "value": 90000,
        "unit": "INR"
      },
      {
        "label": "Units sold",
        "value": 8000,
        "unit": "count"
      }
    ],
    "options": [
      {
        "id": "A",
        "text": "0.625",
        "value": 0.625,
        "misconception": "ABFM.B.LEV.BEP-TOTAL-CONTRIBUTION"
      },
      {
        "id": "B",
        "text": "1,800 units",
        "value": 1800,
        "misconception": "ABFM.B.LEV.BEP-USES-PRICE"
      },
      {
        "id": "C",
        "text": "5,000 units",
        "value": 5000,
        "key": true
      }
    ],
    "resolution": "Each unit contributes 50 - 32 = Rs. 18 towards fixed cost, so break-even is 90,000 / 18 = 5,000 units. Current sales are irrelevant to where break-even sits.",
    "grounding_regime": "doctrinal",
    "grounding": [
      {
        "kind": "definition",
        "source": "Break-even point",
        "locator": "Break-even units = Fixed cost / Contribution per unit"
      }
    ],
    "derived_from": [
      {
        "work": "macmillan/CAIIB-ABFM",
        "edition": "2023",
        "unit": 8,
        "section": "8.5"
      }
    ],
    "verification": {
      "entailed_span": "Break- even point (Fixed Cost / Contribution",
      "second_model_agrees": true,
      "arithmetic": {
        "expression": "fixed_cost / (price - variable_cost)",
        "expected": 5000,
        "tolerance": 0.5
      },
      "verifier": {
        "model": "gemini/antigravity",
        "packet": "v20260923-092220",
        "span_page": 184
      }
    },
    "lifecycle": {
      "state": "field"
    }
  },
  {
    "item_id": "itm_abfm_u8_s05_dflpct",
    "syllabus_node": "ABFM.B.8.3",
    "concept": "ratio-of-percentage-changes",
    "prereqs": [
      "ratio-arithmetic"
    ],
    "bloom": "apply",
    "tier": "caiib",
    "stem": "When a firm's EBIT rises from Rs. 1,00,000 to Rs. 1,25,000, its EPS rises from Rs. 8 to Rs. 11. What degree of financial leverage does this imply?",
    "given": [
      {
        "label": "EBIT old",
        "value": 100000,
        "unit": "INR"
      },
      {
        "label": "EBIT new",
        "value": 125000,
        "unit": "INR"
      },
      {
        "label": "EPS old",
        "value": 8,
        "unit": "INR"
      },
      {
        "label": "EPS new",
        "value": 11,
        "unit": "INR"
      }
    ],
    "options": [
      {
        "id": "A",
        "text": "1.50",
        "value": 1.5,
        "key": true
      },
      {
        "id": "B",
        "text": "0.67",
        "value": 0.67,
        "misconception": "ABFM.B.LEV.RATIO-INVERTED"
      },
      {
        "id": "C",
        "text": "1.36",
        "value": 1.36,
        "misconception": "ABFM.B.LEV.PCT-CHANGE-BASE"
      }
    ],
    "resolution": "EPS rises 3 on 8, or 37.5%. EBIT rises 25,000 on 1,00,000, or 25%. DFL is 37.5% over 25% = 1.50. Both changes are measured from the starting figures.",
    "grounding_regime": "doctrinal",
    "grounding": [
      {
        "kind": "definition",
        "source": "Degree of financial leverage",
        "locator": "DFL = % change in EPS / % change in EBIT"
      }
    ],
    "derived_from": [
      {
        "work": "macmillan/CAIIB-ABFM",
        "edition": "2023",
        "unit": 8,
        "section": "8.3"
      }
    ],
    "verification": {
      "entailed_span": "Degree of Financial Leverage (DFL) = Percentage change in earnings per share (EPS) / Percentage change in earnings before interest and tax (EBIT)",
      "second_model_agrees": true,
      "arithmetic": {
        "expression": "((eps_new - eps_old) / eps_old) / ((ebit_new - ebit_old) / ebit_old)",
        "expected": 1.5,
        "tolerance": 0.005
      },
      "verifier": {
        "model": "gemini/antigravity",
        "packet": "v20260923-092220",
        "span_page": 177
      }
    },
    "lifecycle": {
      "state": "field"
    }
  },
  {
    "item_id": "itm_abfm_u8_s06_dolnil",
    "syllabus_node": "ABFM.B.8.5",
    "concept": "contribution-and-cost-behaviour",
    "prereqs": [
      "ratio-arithmetic"
    ],
    "bloom": "understand",
    "tier": "caiib",
    "stem": "A trader sells 10,000 units at Rs. 40 with a variable cost of Rs. 25 a unit and carries no fixed operating cost at all. What is the degree of operating leverage?",
    "given": [
      {
        "label": "Units",
        "value": 10000,
        "unit": "count"
      },
      {
        "label": "Price",
        "value": 40,
        "unit": "INR"
      },
      {
        "label": "Variable cost",
        "value": 25,
        "unit": "INR"
      },
      {
        "label": "Fixed cost",
        "value": 0,
        "unit": "INR"
      }
    ],
    "options": [
      {
        "id": "A",
        "text": "0.00",
        "value": 0.0,
        "misconception": "ABFM.B.LEV.DOL-FIXED-OVER-EBIT"
      },
      {
        "id": "B",
        "text": "1.00",
        "value": 1.0,
        "key": true
      },
      {
        "id": "C",
        "text": "2.67",
        "value": 2.67,
        "misconception": "ABFM.B.LEV.DOL-SALES-OVER-EBIT"
      }
    ],
    "resolution": "With no fixed cost, contribution and EBIT are the same 1,50,000, so DOL is exactly 1: profit moves in step with sales and nothing is magnified. Operating leverage exists only because of fixed cost.",
    "grounding_regime": "doctrinal",
    "grounding": [
      {
        "kind": "definition",
        "source": "Degree of operating leverage",
        "locator": "DOL = Contribution / EBIT"
      }
    ],
    "derived_from": [
      {
        "work": "macmillan/CAIIB-ABFM",
        "edition": "2023",
        "unit": 8,
        "section": "8.5"
      }
    ],
    "verification": {
      "entailed_span": "Situation 1: No Fixed Cost",
      "second_model_agrees": true,
      "arithmetic": {
        "expression": "units * (price - variable_cost) / (units * (price - variable_cost) - fixed_cost)",
        "expected": 1.0,
        "tolerance": 0.005
      },
      "verifier": {
        "model": "gemini/antigravity",
        "packet": "v20260923-092220",
        "span_page": 183
      }
    },
    "lifecycle": {
      "state": "field"
    }
  },
