      {
        "label": "Contribution",
        "value": 300000,
        "unit": "INR"
      },
      {
        "label": "EBIT",
        "value": 120000,
        "unit": "INR"
      },
      {
        "label": "Interest",
        "value": 40000,
        "unit": "INR"
      }
    ],
    "options": [
      {
        "id": "A",
        "text": "3.75",
        "value": 3.75,
        "key": true
      },
      {
        "id": "B",
        "text": "2.50",
        "value": 2.5,
        "misconception": "ABFM.B.LEV.DTL-OMITS-FINANCIAL"
      },
      {
        "id": "C",
        "text": "4.00",
