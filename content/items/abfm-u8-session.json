[
  {
    "item_id": "itm_abfm_u8_s01_dfl",
    "syllabus_node": "ABFM.B.8.3",
    "concept": "ratio-of-percentage-changes",
    "prereqs": [
      "ratio-arithmetic"
    ],
    "bloom": "apply",
    "tier": "caiib",
    "stem": "A firm earns EBIT of Rs. 5,00,000, pays interest of Rs. 2,00,000 and is taxed at 30%. What is its degree of financial leverage?",
    "given": [
      {
        "label": "EBIT",
        "value": 500000,
        "unit": "INR"
      },
      {
        "label": "Interest",
        "value": 200000,
        "unit": "INR"
      },
      {
        "label": "Tax rate",
        "value": 0.3,
        "unit": "fraction"
      }
    ],
    "options": [
      {
        "id": "A",
        "text": "0.60",
        "value": 0.6,
        "misconception": "ABFM.B.LEV.RATIO-INVERTED"
      },
      {
        "id": "B",
        "text": "1.00",
        "value": 1.0,
        "misconception": "ABFM.B.LEV.INTEREST-SUBTRACTED-TWICE"
      },
      {
        "id": "C",
        "text": "1.67",
        "value": 1.67,
        "key": true
      },
      {
        "id": "D",
        "text": "1.17",
        "value": 1.17,
        "misconception": "ABFM.B.LEV.TAX-APPLIED-TO-DFL"
      }
    ],
    "resolution": "EBT is 5,00,000 less 2,00,000 = 3,00,000, and DFL is EBIT over EBT = 1.67. The 30% tax plays no part: it scales EPS and EBT alike, so it cancels.",
    "grounding_regime": "doctrinal",
    "grounding": [
      {
        "kind": "definition",
        "source": "Degree of financial leverage",
        "locator": "DFL = EBIT / EBT"
      }
    ],
    "derived_from": [
      {
        "work": "macmillan/CAIIB-ABFM",
        "edition": "2023",
        "unit": 8,
        "section": "8.3"
      }
    ],
    "verification": {
      "entailed_span": "Or, DFL = EBIT / EBT",
      "second_model_agrees": true,
      "arithmetic": {
        "expression": "ebit / (ebit - interest)",
        "expected": 1.6666667,
        "tolerance": 0.005
      },
      "verifier": {
        "model": "gemini/antigravity",
        "packet": "v20260923-092220",
        "span_page": 178
      }
    },
    "lifecycle": {
      "state": "field"
    }
  },
  {
    "item_id": "itm_abfm_u8_s02_dol",
    "syllabus_node": "ABFM.B.8.5",
    "concept": "contribution-and-cost-behaviour",
    "prereqs": [
      "ratio-arithmetic"
    ],
    "bloom": "apply",
    "tier": "caiib",
    "stem": "A unit sells 8,000 items at Rs. 60 each. Variable cost is Rs. 35 an item and fixed operating cost is Rs. 1,20,000. What is its degree of operating leverage?",
    "given": [
      {
        "label": "Units",
        "value": 8000,
        "unit": "count"
      },
      {
        "label": "Price",
        "value": 60,
        "unit": "INR"
      },
      {
        "label": "Variable cost",
        "value": 35,
        "unit": "INR"
      },
      {
        "label": "Fixed cost",
        "value": 120000,
        "unit": "INR"
      }
    ],
    "options": [
      {
        "id": "A",
        "text": "0.40",
        "value": 0.4,
        "misconception": "ABFM.B.LEV.RATIO-INVERTED"
      },
      {
        "id": "B",
        "text": "1.50",
        "value": 1.5,
        "misconception": "ABFM.B.LEV.DOL-FIXED-OVER-EBIT"
      },
      {
        "id": "C",
        "text": "6.00",
        "value": 6.0,
        "misconception": "ABFM.B.LEV.DOL-SALES-OVER-EBIT"
      },
      {
        "id": "D",
        "text": "2.50",
        "value": 2.5,
        "key": true
      }
    ],
    "resolution": "Contribution is 8,000 x (60 - 35) = 2,00,000. EBIT is that less 1,20,000 = 80,000. DOL is contribution over EBIT = 2.50.",
    "grounding_regime": "doctrinal",
    "grounding": [
      {
        "kind": "definition",
        "source": "Degree of operating leverage",
        "locator": "DOL = Contribution / EBIT"
      }
    ],
    "derived_from": [
      {
        "work": "macmillan/CAIIB-ABFM",
        "edition": "2023",
        "unit": 8,
        "section": "8.5"
      }
    ],
    "verification": {
      "entailed_span": "DOL = Contribution / Earnings Before Interest and Taxes (EBIT)",
      "second_model_agrees": true,
      "arithmetic": {
        "expression": "units * (price - variable_cost) / (units * (price - variable_cost) - fixed_cost)",
        "expected": 2.5,
        "tolerance": 0.005
      },
      "verifier": {
        "model": "gemini/antigravity",
        "packet": "v20260923-092220",
        "span_page": 181
      }
    },
    "lifecycle": {
      "state": "field"
    }
  },
  {
    "item_id": "itm_abfm_u8_s03_dtl",
