[
 {
  "item_id": "itm_abfm_u8_dfl_001",
  "syllabus_node": "ABFM.B.8.3",
  "concept": "ratio-of-percentage-changes",
  "stem": "A company reports EBIT of Rs. 40,00,000 against interest of Rs. 10,00,000, and is taxed at 30%. What is its degree of financial leverage?",
  "given": [
   {
    "label": "EBIT",
    "value": 4000000,
    "unit": "INR"
   },
   {
    "label": "Interest",
    "value": 1000000,
    "unit": "INR"
   },
   {
    "label": "Tax rate",
    "value": 0.3,
    "unit": "fraction"
   }
  ],
  "options": [
   {
    "id": "A",
    "text": "1.33",
    "key": true,
    "misconception": null
   },
   {
    "id": "B",
    "text": "1.00",
    "key": false,
    "misconception": "ABFM.B.LEV.INTEREST-SUBTRACTED-TWICE"
   },
   {
    "id": "C",
    "text": "0.93",
    "key": false,
    "misconception": "ABFM.B.LEV.TAX-APPLIED-TO-DFL"
   },
   {
    "id": "D",
    "text": "0.75",
    "key": false,
    "misconception": "ABFM.B.LEV.DFL-DOL-SWAPPED"
   }
  ],
  "resolution": "DFL is EBIT divided by EBT, here 40,00,000 over 30,00,000. Tax never enters it: it scales EPS and EBT by the same factor, so it cancels out of a ratio of percentage changes.",
  "grounding": [
   {
    "source": "Degree of financial leverage",
    "locator": "DFL = EBIT / EBT"
   }
  ],
  "psychometrics": {
   "a": null,
   "b": null
  },
