    "label": "EBIT",
    "value": 120000,
    "unit": "INR"
   },
   {
    "label": "Interest",
    "value": 40000,
    "unit": "INR"
   }
  ],
  "options": [
   {
    "id": "A",
    "text": "3.75",
    "key": true,
