    "label": "EBIT new",
    "value": 125000,
    "unit": "INR"
   },
   {
    "label": "EPS old",
    "value": 8,
    "unit": "INR"
   },
   {
    "label": "EPS new",
    "value": 11,
    "unit": "INR"
   }
  ],
  "options": [
   {
    "id": "A",
    "text": "1.50",
    "key": true,
    "misconception": null
   },
   {
    "id": "B",
    "text": "0.67",
    "key": false,
    "misconception": "ABFM.B.LEV.RATIO-INVERTED"
